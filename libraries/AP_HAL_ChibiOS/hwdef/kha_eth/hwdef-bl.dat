MCU STM32H7xx STM32H743xx

OSCILLATOR_HZ 25000000

FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128
FLASH_RESERVE_END_KB 256
FLASH_SIZE_KB 2048

RAM_RESERVE_START 256

# board ID for firmware load
APJ_BOARD_ID 1315

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

env AP_PERIPH 1

# Now we define the pins that USB is connected on.
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# order of UARTs (and USB)
SERIAL_ORDER OTG1

# CAN setup
PB8 CAN1_RX CAN1
PB9 CAN1_TX CAN1

define CAN_APP_NODE_NAME "kha.eth-bl"
define HAL_BOOTLOADER_TIMEOUT 2000

PE11 LED_RED OUTPUT LOW GPIO(3)
PE12 LED_GRN OUTPUT LOW GPIO(4)
define HAL_GPIO_PIN_LED_BOOTLOADER HAL_GPIO_PIN_LED_RED
define HAL_GPIO_PIN_LED_ACTIVITY HAL_GPIO_PIN_LED_GRN
define HAL_LED_ON 1

