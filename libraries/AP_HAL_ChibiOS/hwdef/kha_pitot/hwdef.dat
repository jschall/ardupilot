# hw definition file for processing by chibios_hwdef.py
# for H757

# MCU class and specific type
MCU STM32H7xx STM32H757xx


define CORE_CM7
define SMPS_PWR

define HAL_BUILD_AP_PERIPH

# board ID for firmware load
APJ_BOARD_ID 1357

# setup build for a peripheral firmware
env AP_PERIPH 1

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
FLASH_RESERVE_END_KB 256
FLASH_BOOTLOADER_LOAD_KB 128
RAM_RESERVE_START 256

# crystal frequency
OSCILLATOR_HZ 24000000

# These are the pins for SWD debugging with a STlinkv2 or black-magic probe.
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# override following defines as needed
STORAGE_FLASH_PAGE 14
define HAL_STORAGE_SIZE 32768

# ##########################
# CAN1
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1

# CAN2
#PB5 CAN2_RX CAN2
#PB6 CAN2_TX CAN2


# CAN Common
PG1 SLEEPCAN OUTPUT PUSHPULL SPEED_LOW LOW 
PG0 SHUTDOWNCAN OUTPUT PUSHPULL SPEED_LOW LOW

define CAN_APP_NODE_NAME "kha.pitot"

# supports upto 8MBits/s
CANFD_SUPPORTED 8

# ##########################

# USB, Serial 0
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SERIAL - AUX
PC7  USART6_RX USART6
PC6  USART6_TX USART6

SERIAL_ORDER OTG1 USART6

PB7 I2C1_SDA I2C1
PB8 I2C1_SCL I2C1
I2C_ORDER I2C1


# Aux Port (debug)
PC0 GPIO1 INPUT GPIO(1)
PA4 ADC1_AUX ADC1 SCALE(1) ANALOG(1)

# Lights/LEDS
PC9 LED_RED OUTPUT LOW GPIO(2)
define HAL_GPIO_PIN_LED            HAL_GPIO_PIN_LED_RED
define HAL_LED_ON 1

# HEATER
#PE11 TIM1_CH2 TIM1 PWM(1) GPIO(3)
PE11 PITOT_HEATER_ENABLE OUTPUT LOW GPIO(3)
PB0  PITOT_HEATER_CURRENT ADC1 SCALE(1) ANALOG(2)

# Unused for now
PF11 STAR_VOLTAGE_GOOD INPUT PULLUP GPIO(20)
PA6  PORT_VOLTAGE_GOOD INPUT PULLUP GPIO(21)
PF12 USB_VOLTAGE_GOOD  INPUT PULLUP GPIO(22)
PE2  BOARD_VERSION1    INPUT PULLUP GPIO(23)


# ---------------------------------------------------------------------------------------------
# AP_Periph - boiler-plate configurations that all HW AP-Periph need
# ---------------------------------------------------------------------------------------------
define DISABLE_SERIAL_ESC_COMM TRUE
define HAL_NO_RCIN_THREAD
define HAL_DISABLE_LOOP_DELAY

#################################
# AP_Periph - configurations specific to this App
#################################
define HAL_PERIPH_ENABLE_AIRSPEED 1
define AIRSPEED_MAX_SENSORS 1

define HAL_PERIPH_ENABLE_BATTERY
define AP_BATT_MONITOR_MAX_INSTANCES 2



# listen for reboot command from uploader.py script
# undefine to disable. Use -1 to allow on all ports, otherwise serial number index defined in SERIAL_ORDER starting at 0
define HAL_PERIPH_LISTEN_FOR_SERIAL_UART_REBOOT_CMD_PORT 0
define HAL_PERIPH_LISTEN_FOR_SERIAL_UART_REBOOT_NON_DEBUG
#######################################################################

# FEATURE: Temp sensors
define AP_TEMPERATURE_SENSOR_ENABLED 1
define AP_TEMPERATURE_SENSOR_MAX_INSTANCES 1

define AP_TEMPERATURE_SENSOR_TSYS01_ENABLED 0
define AP_TEMPERATURE_SENSOR_MCP9600_ENABLED 1
define AP_TEMPERATURE_SENSOR_MAX31865_ENABLED 1

#################################


AUTOBUILD_TARGETS None

define KHA_PERIPH_PITOT 1
define AP_KHA_ENABLED 1
