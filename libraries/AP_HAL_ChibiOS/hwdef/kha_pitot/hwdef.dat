# hw definition file for processing by chibios_hwdef.py
# for H757

# MCU class and specific type
MCU STM32H7xx STM32H757xx


define CORE_CM7
define SMPS_PWR

define HAL_BUILD_AP_PERIPH

# board ID for firmware load
APJ_BOARD_ID 1357

# setup build for a peripheral firmware
env AP_PERIPH 1

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
FLASH_RESERVE_END_KB 256
FLASH_BOOTLOADER_LOAD_KB 128
RAM_RESERVE_START 256

# crystal frequency
OSCILLATOR_HZ 24000000

# These are the pins for SWD debugging with a STlinkv2 or black-magic probe.
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# override following defines as needed
STORAGE_FLASH_PAGE 14
define HAL_STORAGE_SIZE 32768

# ##########################
# CAN1
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1

# CAN2
PB5 CAN2_RX CAN2
PB6 CAN2_TX CAN2


# CAN Common
PG1 SLEEPCAN OUTPUT PUSHPULL SPEED_LOW LOW 
PG0 SHUTDOWNCAN OUTPUT PUSHPULL SPEED_LOW LOW

define CAN_APP_NODE_NAME "kha.pitot"

# supports upto 8MBits/s
CANFD_SUPPORTED 8

# ##########################

# USB, Serial 0
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PC9 VBUS INPUT OPENDRAIN

# Payload A, Serial 1
# PE7  UART7_RX UART7
# PE8  UART7_TX UART7
# PA3  TIM2_CH4 TIM2 PWM(1) GPIO(1)
# PE10 PAYLOAD_A_ENABLE OUTPUT LOW GPIO(11)
# PC12 PAYLOAD_A_GOOD INPUT GPIO(21)
# PC3  PAYLOAD_A_CURRENT ADC1 SCALE(1) ANALOG(31)

# Payload B, Serial 2
# PC11 USART3_RX USART3
# PC10 USART3_TX USART3
# PA15 TIM2_CH1 TIM2 PWM(2) GPIO(2)
# PE2  PAYLOAD_B_ENABLE OUTPUT LOW GPIO(12)
# PB7  PAYLOAD_B_GOOD INPUT GPIO(22)
# PF3  PAYLOAD_B_CURRENT ADC3 SCALE(1) ANALOG(32)

# Payload C, Serial 3
# PE0  UART8_RX UART8
# PE1  UART8_TX UART8
# PB10 TIM2_CH3 TIM2 PWM(3) GPIO(3)
# PE11 PAYLOAD_C_ENABLE OUTPUT LOW GPIO(13)
# #PF13 PAYLOAD_C_GOOD INPUT GPIO(23)
# PF13 PAYLOAD_C_GOOD ADC2 SCALE(1) ANALOG(23)
# PC2  PAYLOAD_C_CURRENT ADC1 SCALE(1) ANALOG(33)

# HEATER 
PE11 TIM1_CH2 TIM1 PWM(3) GPIO(3)                                          # ADDED BY DAVID
PA4  PITOT_HEATER_CURRENT ADC1 SCALE(1) ANALOG(38)

#SEREAL
PC7  USART6_RX USART6
PC6  USART6_TX USART6

PF11 STAR_VOLTAGE_GOOD OUTPUT LOW GPIO(18)
PA6  PORT_VOLTAGE_GOOD OUTPUT LOW GPIO(19)
PF12 USB_VOLTAGE_GOOD  OUTPUT LOW GPIO(20)                                   # FIX THIS


# Payload D, Serial 4
# PB8  UART4_RX UART4
# PA0  UART4_TX UART4
# PE14 TIM1_CH4 TIM1 PWM(4) GPIO(4)
# PE6  PAYLOAD_D_ENABLE OUTPUT LOW GPIO(14)
# #PF14 PAYLOAD_D_GOOD INPUT GPIO(24)
# PF14  PAYLOAD_D_GOOD ADC2 SCALE(1) ANALOG(24)
# PB1  PAYLOAD_D_CURRENT ADC1 SCALE(1) ANALOG(34)

# Payload E, Serial 5
# PA10 USART1_RX USART1
# PA9  USART1_TX USART1
# PE5  TIM15_CH1 TIM15 PWM(5) GPIO(5)
# PC0  PAYLOAD_E_ENABLE OUTPUT LOW GPIO(15)
# #PF4  PAYLOAD_E_GOOD INPUT GPIO(25)
# PF4  PAYLOAD_E_GOOD ADC3 SCALE(1) ANALOG(25)
# PB0  PAYLOAD_E_CURRENT ADC1 SCALE(1) ANALOG(35)

# Aux
# PE13 AUX_ENABLE OUTPUT LOW GPIO(16)
# #PA6  AUX_GOOD INPUT GPIO(26)
# PA6  AUX_GOOD ADC1 SCALE(1) ANALOG(26)
# PF11 AUX_CURRENT ADC1 SCALE(1) ANALOG(36)

# GPS, Serial 6
# PC7  USART6_RX USART6
# PC6  USART6_TX USART6
# PE9  GPS_PPS INPUT PULLDOWN GPIO(27)

# Port wing
# PA4  PORT_WING_CURRENT ADC1 SCALE(1) ANALOG(38)
# PD13 PORT_WING_GOOD INPUT GPIO(28)

# Starboard wing
# PA5  STRB_WING_CURRENT ADC1 SCALE(1) ANALOG(39)
# PD12 STRB_WING_GOOD INPUT GPIO(29)

# Lights/LEDS
# PF12 LIGHTS_ENABLE OUTPUT LOW GPIO(18)
# PD14 LED_GREEN OUTPUT LOW GPIO(19)
# PD15 LED_RED OUTPUT LOW GPIO(20)
# define HAL_GPIO_PIN_LED            HAL_GPIO_PIN_LED_GREEN
# define HAL_GPIO_PIN_LED_BATT_CALIBRATE HAL_GPIO_PIN_LED_RED
# define HAL_LED_ON 1



# Serial 0 = USB, Serial 1-5 = Payload A-F, Serial 6 = GPS
SERIAL_ORDER OTG1 USART6

# ##########################


# ##########################

# Ethernet
# PC1  ETH_MDC            ETH1
# PA2  ETH_MDIO           ETH1
# PC4  ETH_RMII_RXD0      ETH1
# PC5  ETH_RMII_RXD1      ETH1
# PB12 ETH_RMII_TXD0      ETH1
# PB13 ETH_RMII_TXD1      ETH1
# PB11 ETH_RMII_TX_EN     ETH1
# PA7  ETH_RMII_CRS_DV    ETH1
# PA1  ETH_RMII_REF_CLK   ETH1

